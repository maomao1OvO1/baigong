{
  "_说明": "工具清单 —— 全站唯一的注册表。生成器（build.mjs）只读这里，不写死任何工具。",
  "_加新工具": [
    "1. tools[] 里加一条：id / icon / kind / script / i18n / options",
    "2. src/i18n/tools/<i18n>.json 加三语文案",
    "3. assets/tools/<script> 写逻辑（用 TP 共享函数，控件 id 与 options 里一致）",
    "4. node test/check.mjs && node test/runtime.mjs —— 全绿再 node src/build.mjs 上传"
  ],
  "_kind": {
    "image": "拖拽区 + 控件 + 主按钮 + 结果列表（图片类）",
    "text": "输入框 + 控件 + 结果框 + 复制/清空按钮（文本类）"
  },
  "_options 类型": {
    "range": "滑块：id, label, min, max, value, suffix, showValue(显示数值的元素 id), hint(说明文案键)",
    "number": "数字框：id, label, value, min, step, placeholder, note(说明文案键)",
    "select": "下拉：id, label, choices[[值, 文案键], ...], hint(说明文案键)",
    "color": "系统取色器：id（color 类工具用）",
    "checkbox": "复选框：id, label, checked（成组出现）"
  },
